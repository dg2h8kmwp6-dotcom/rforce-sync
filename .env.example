APP_NAME="rForce Sync"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rforce_sync
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# rForce / Salesforce gateway
# ---------------------------------------------------------------------------
# Base URL of the gateway that fronts rForce/Salesforce. Trailing slash optional.
RFORCE_BASE_URL=https://gateway.example.com/rforce
# OAuth token endpoint. Often the gateway exposes its own token URL; otherwise
# this would be the Salesforce token endpoint (e.g. https://login.salesforce.com/services/oauth2/token).
RFORCE_AUTH_URL=https://gateway.example.com/rforce/oauth/token
# Auth strategy. Supported: oauth_client_credentials | oauth_password | static_token
RFORCE_AUTH_STRATEGY=oauth_client_credentials
RFORCE_CLIENT_ID=
RFORCE_CLIENT_SECRET=
# Only set for oauth_password strategy.
RFORCE_USERNAME=
RFORCE_PASSWORD=
# Only set for static_token strategy (e.g. pre-issued bearer token from gateway).
RFORCE_STATIC_TOKEN=
# HTTP behavior
RFORCE_TIMEOUT=30
RFORCE_RETRY_ATTEMPTS=3
RFORCE_RETRY_SLEEP=500

# ---------------------------------------------------------------------------
# Google Sheets export (optional / scaffolded behind interface; not yet wired)
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=

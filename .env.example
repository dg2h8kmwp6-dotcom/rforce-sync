APP_NAME="rForce Sync"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rforce_sync
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# rForce / Salesforce via MuleSoft Data Gateway
# ---------------------------------------------------------------------------
# Which environment the Data Gateway URL defaults to: test | stage | prod.
# Local/dev should usually point at stage.
RFORCE_ENVIRONMENT=stage

# Full Data Gateway query endpoint. Leave blank to inherit from RFORCE_ENVIRONMENT.
#   test:  https://it1apitst2.andersencorp.com/api/rforce/control-layer/query
#   stage: https://it1apistg2.andersencorp.com/api/rforce/control-layer/query
#   prod:  https://it1api2.andersencorp.com/api/rforce/control-layer/query
RFORCE_BASE_URL=https://it1apistg2.andersencorp.com/api/rforce/control-layer/query

# MuleSoft proxy credentials.
RFORCE_PROXY_CLIENT_ID=
RFORCE_PROXY_CLIENT_SECRET=

# Salesforce credentials the gateway forwards.
RFORCE_SF_CLIENT_ID=
RFORCE_SF_CLIENT_SECRET=

# Salesforce REST API version. Default v60.0; v58.0 also seen in docs.
RFORCE_SF_VERSION=v60.0

# Optional Salesforce environment URL override (only set if the gateway needs it).
RFORCE_SF_ENVIRONMENT_URL=

# HTTP behavior.
RFORCE_TIMEOUT=300
RFORCE_RETRY_ATTEMPTS=3
RFORCE_RETRY_SLEEP=10000

# Queue used for sync jobs.
RFORCE_QUEUE=default

# ---------------------------------------------------------------------------
# Google Sheets export (optional / scaffolded behind interface)
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=
